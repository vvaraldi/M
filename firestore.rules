rules_version = '2';

// M dealer portal - Firestore security rules (database: m-dealer-db)
//
// Principle: everything is denied unless a rule below allows it.
//  - Only the admin (the owner) can write anything, except a user's own display language.
//  - A person can read stock only if the admin invited them (a document in /users/<email>)
//    and the invitation is active.
//  - Stock and prices are stored one document per BRAND (items__skitrab, SHOP_CAD__skitrab, ...).
//    A user can only read the brands on their own invitation (users/<email>.brands), so a shop
//    cannot see another brand even with browser developer tools.
//  - Prices are also one document per price tier. A user can only read the tier written on their
//    own invitation, so a CAD shop cannot read USD, retail or export prices either.
//  - Warehouse locations, brand lists and upload details live in /admin and are never readable by shops.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
          && request.auth.token.email != null
          && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && myEmail() == 'vincent.varaldi@gmail.com';
    }
    function myUserPath() {
      return /databases/$(database)/documents/users/$(myEmail());
    }
    function isInvited() {
      return signedIn() && exists(myUserPath()) && get(myUserPath()).data.active == true;
    }
    function myData() {
      return get(myUserPath()).data;
    }
    // Brand keys (lower case letters and digits) the admin allowed for this user. Missing = none.
    function myBrands() {
      return myData().get('brands', []);
    }
    // stock/meta (date and contact only) or stock/items__<brand> for an allowed brand.
    function stockDocReadable(docId) {
      return docId == 'meta'
          || (docId.matches('items__[a-z0-9]+') && docId.split('__')[1] in myBrands());
    }
    // prices/<TIER>__<brand>: the user's own tier AND an allowed brand.
    function priceDocReadable(docId) {
      return docId.matches('[A-Z]+_[A-Z]{3}__[a-z0-9]+')
          && docId.split('__')[0] == myData().priceTier
          && docId.split('__')[1] in myBrands();
    }

    // One invitation per email address. Document id = the email address in lower case.
    match /users/{email} {
      allow read: if isAdmin() || (signedIn() && email == myEmail());
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && email == myEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['language'])
            && request.resource.data.language in ['en', 'fr', 'it']);
    }

    // One document per shop (name, currency, price tier, brands, addresses).
    match /shops/{shopId} {
      allow read: if isAdmin() || (isInvited() && myData().shopId == shopId);
      allow write: if isAdmin();
    }

    // Published stock: /stock/meta (date and contact only) and /stock/items__<brand> (lines, no prices, no location).
    match /stock/{docId} {
      allow read: if isAdmin() || (isInvited() && stockDocReadable(docId));
      allow write: if isAdmin();
    }

    // Prices: one document per tier and brand, e.g. SHOP_CAD__skitrab, RETAIL_USD__villacampa.
    match /prices/{docId} {
      allow read: if isAdmin() || (isInvited() && priceDocReadable(docId));
      allow write: if isAdmin();
    }

    // Admin-only data (warehouse locations, brand list, upload details, later: requests export).
    match /admin/{docId} {
      allow read, write: if isAdmin();
    }

    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
